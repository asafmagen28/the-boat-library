erDiagram
    lib_authors ||--o{ elib_books : "writes"
    elib_books ||--o{ lib_copy : "has"
    lib_copy ||--o{ lib_loans : "loaned_as"
    lib_copy }o--|| lib_status : "has_status"
    
    lib_users ||--o{ lib_loans : "borrows"
    lib_users }o--|| lib_role : "has_role"
    lib_users ||--o{ lib_transactions : "receives (target)"
    lib_users ||--o{ lib_transactions : "initiates (actor)"
    lib_users ||--o{ lib_employee_codes : "creates"
    
    lib_transactions }o--|| lib_transactions_type : "has_type"
    lib_loans ||--o| lib_transactions : "generates"

    lib_authors {
        int ID PK
        string firstName
        string surname
        timestamptz createdAt
        timestamptz updatedAt
        timestamptz deletedAt
    }

    elib_books {
        int ID PK
        string title
        int authorID FK
        decimal price
        decimal fee
        timestamptz createdAt
        timestamptz updatedAt
        timestamptz deletedAt
    }

    lib_copy {
        int ID PK
        int bookID FK
        int status FK
        timestamptz createdAt
        timestamptz updatedAt
    }

    lib_users {
        int ID PK
        string username
        string password
        int role FK
        timestamptz createdAt
        timestamptz updatedAt
        timestamptz deletedAt
    }

    lib_loans {
        int ID PK
        int copyID FK
        decimal price
        decimal fee
        date loanDate
        date deadLineDate
        date returnDate
        int loanedUser FK
        timestamptz createdAt
        timestamptz updatedAt
    }

    lib_transactions {
        int ID PK
        decimal amount
        int targetUserID FK
        int actorID FK
        int transType FK
        int loanID FK "nullable"
        timestamptz createdAt
        timestamptz updatedAt
    }

    lib_role {
        int ID PK
        string roleName
    }

    lib_status {
        int ID PK
        string status
    }

    lib_transactions_type {
        int ID PK
        string type
    }

    lib_employee_codes {
        int ID PK
        boolean isUsed
        string codeHash
        timestamptz expiresAt
        int createdBy FK
        timestamptz createdAt
        timestamptz updatedAt
    }